{
  "name": "barberup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/icons.mjs && tsc -b && vite build && node scripts/service-worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,mjs,mts,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.json\" \"*.ts\" \"*.html\" README.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "prettier": "3.6.2"
  }
}
